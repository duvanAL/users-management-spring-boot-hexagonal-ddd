# Ejemplo para desarrollo local; no usar estos valores en Render.
# Copiar a .env. Ese archivo local está excluido de Git y del contexto Docker.

# PostgreSQL 17 en Docker Compose
POSTGRES_DB=crud_usuarios
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_only_change_me
DB_LOCAL_PORT=5435

# Aplicación ejecutada en el equipo (no dentro de un contenedor)
DB_HOST=localhost
DB_PORT=5435
DB_NAME=crud_usuarios
DB_USERNAME=postgres
DB_PASSWORD=local_only_change_me
DB_SSLMODE=disable
DB_SCHEMA_INIT_MODE=always
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=0
DB_CONNECTION_TIMEOUT_MS=30000

# Funciones opcionales desactivadas; definir credenciales reales solo si se usan.
APP_EMAIL_ENABLED=false
APP_EMAIL_PROVIDER=gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_ADDRESS=
GMAIL_SENDER_NAME=Gestion de Usuarios
# Kafka queue is disabled locally unless explicitly enabled.
APP_KAFKA_ENABLED=false
APP_RUNTIME_ROLE=api
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_USERS_GROUP_ID=users-api
KAFKA_NOTIFY_GROUP_ID=notify-service
KAFKA_TOPIC_NOTIFICATION_REQUESTED=user.notification.requested
KAFKA_TOPIC_NOTIFICATION_RESULT=user.notification.result
KAFKA_TOPIC_NOTIFICATION_DLQ=user.notification.dlq
KAFKA_SEND_TIMEOUT_MS=10000
KAFKA_LISTENER_AUTO_STARTUP=true
# Brevo is not selected by default; use only after setting APP_EMAIL_PROVIDER=brevo.
BREVO_BASE_URL=https://api.brevo.com
BREVO_API_KEY=
BREVO_FROM_ADDRESS=
BREVO_FROM_NAME=Gestion de Usuarios
BREVO_CONNECT_TIMEOUT_MS=3000
BREVO_READ_TIMEOUT_MS=10000
BREVO_RETRY_MAX_ATTEMPTS=3
BREVO_RETRY_INITIAL_DELAY_MS=500
BREVO_RETRY_MULTIPLIER=2.0
BREVO_CIRCUIT_FAILURE_THRESHOLD=50
BREVO_CIRCUIT_WINDOW_SIZE=10
BREVO_CIRCUIT_MINIMUM_CALLS=5
BREVO_CIRCUIT_OPEN_DURATION_MS=30000
SEED_ADMIN_ENABLED=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
